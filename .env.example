DATABASE_URL=postgresql://kidsic:kidsic_local@localhost:55432/kidsic
CKAN_BASE_URL=https://data.gov.hr/ckan
CKAN_ZAGREB_BASE_URL=https://data.zagreb.hr
CKAN_DATASET_ID=djecji-vrtici
CKAN_ZAGREB_MUNICIPAL_DATASET_ID=gradski_vrtici_grada_zagreba
CKAN_ZAGREB_OTHER_DATASET_ID=privatni-vjerski-obrti-gz-kontakt-podaci
CKAN_VARAZDIN_CHILDMINDERS_DATASET_ID=grad-varazdin-dadilje
CKAN_VARAZDIN_CHILDMINDERS_RESOURCE_ID=2bde0eae-1d20-41c5-aec4-711f2a485439
CKAN_RIJEKA_BASE_URL=https://data.rijeka.hr
CKAN_RIJEKA_DATASET_ID=djecji-vrtici
