CKAN_TIMEOUT=15
CKAN_MAX_BYTES=10485760
OTP_URL=http://127.0.0.1:18080/otp/gtfs/v1
# Offline OSM address lookup for the commute MCP tool.
KIDSIC_ADDRESS_INDEX=routing/data/addresses.sqlite
# Zagreb uses its own graph and address index; Rijeka keeps the settings above.
OTP_URL_ZAGREB=http://127.0.0.1:18081/otp/gtfs/v1
KIDSIC_ADDRESS_INDEX_ZAGREB=routing/data/zagreb/addresses.sqlite
# Šibenik uses the reviewed Gradski parking timetable and a separate OSM index.
OTP_URL_SIBENIK=http://127.0.0.1:18082/otp/gtfs/v1
KIDSIC_ADDRESS_INDEX_SIBENIK=routing/data/sibenik/addresses.sqlite
