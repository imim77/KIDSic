' Korisnikov početni primjer rasporeda paketa iz razgovora:
' @startuml
' package "src/KIDSic" as Backend {
'     package "Services" as Services {}
'     package "Something" as Something {}
'     package "22" as Package22 {}
' }
' package "frontend/src" as Frontend {
'     package "mvvm" as Something {}
'     package "22" as Package22 {}
' }
' Primjer ispod je kasniji dijagram projekta, s jedinstvenim aliasima.

@startuml

skinparam ArrowColor #212529
skinparam package {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

package "src/KIDSic" as Backend {
    package "api" as BackendApi {
        package "apps" as BackendApiApps {}
    }
    package "commands" as BackendCommands {}
    package "config" as BackendConfig {}
    package "dao" as BackendDao {
        package "concrete" as DaoConcrete {}
        package "interfaces" as DaoInterfaces {}
    }
    package "db" as BackendDb {
        package "alembic" as DbAlembic {
            package "versions" as AlembicVersions {}
        }
        package "models" as DbModels {}
        package "seeds" as DbSeeds {}
        package "uow" as DbUow {}
    }
    package "dto" as BackendDto {}
    package "factories" as BackendFactories {}
    package "integrations" as BackendIntegrations {
        package "concrete" as IntegrationsConcrete {}
        package "interfaces" as IntegrationsInterfaces {}
    }
    package "mcp" as BackendMcp {}
    package "services" as BackendServices {
        package "concrete" as ServicesConcrete {
            package "parsers" as ServicesParsers {}
        }
        package "interfaces" as ServicesInterfaces {}
    }
}

package "frontend/src" as Frontend {
    package "mvvm" as FrontendMvvm {
        package "components" as MvvmComponents {
            package "ui" as MvvmUi {}
        }
        package "features" as MvvmFeatures {
            package "Commute" as FeatureCommute {
                package "__integrations__" as CommuteIntegrationTests {}
                package "components" as CommuteComponents {}
                package "hooks" as CommuteHooks {}
                package "utils" as CommuteUtils {}
            }
            package "Locations" as FeatureLocations {
                package "__integrations__" as LocationsIntegrationTests {}
                package "components" as LocationsComponents {
                    package "map" as LocationsMap {}
                }
                package "hooks" as LocationsHooks {}
                package "screens" as LocationsScreens {
                    package "CityMap" as CityMapScreen {}
                    package "McpLocation" as McpLocationScreen {}
                }
                package "utils" as LocationsUtils {}
            }
        }
        package "hooks" as MvvmHooks {}
        package "utils" as MvvmUtils {}
    }
    package "pages" as FrontendPages {}
}
Frontend -[hidden]down-> Backend
LocationsUtils ..> BackendApi : HTTP: /api/locations
MvvmHooks ..> BackendApi : MCP alati preko hosta
BackendApiApps ..> FrontendPages : MCP HTML resurs (build)
@enduml
