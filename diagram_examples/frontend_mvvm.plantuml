' ==============================================================================
' kidsic-frontend-mvvm.puml
'
' Svrha:    Prikazuje MVVM organizaciju React frontenda projekta KIDSic,
'           povezanost prikaza, ViewModel hookova i izvora podataka.
' Praćenje: Razredi i hookovi navedeni su prema implementaciji frontend/src.
'
' Diagram level: Frontend Logical Architecture
' Diagram type: UML Component Diagram
' ==============================================================================

@startuml
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #212529
skinparam component {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

rectangle "Frontend KIDSic — React / TypeScript" {
    package "Ulaz i povezivanje prikaza" {
        component "McpLocationApp" as McpApp
        component "CityMapApp" as CityApp
    }
    package "View — prikaz" {
        component "McpLocationView" as McpView
        component "KindergartenExplorer\nkarte, kartice i detalji" as Explorer
        component "CommuteView\npreporuke i putovanja" as CommuteView
    }
    package "ViewModel — stanje i radnje" {
        component "useMcpLocations" as McpVM
        component "useCityMap\ni useLocations" as CityVM
        component "useKindergartenExplorer\ni useCommute" as LocalVM
    }
    package "Model i adapteri" {
        component "Locations/types.ts i Commute/types.ts\nLocationCollection, CommuteResult" as Model
        component "LocationToolResult\ni obrada rezultata putovanja" as Decode
        component "useMcpApp\nveza s MCP hostom" as Bridge
        component "LocationDirectory\nHTTP dohvat lokacija" as Directory
    }
}

McpApp --> McpVM : poziva hook
McpApp --> McpView : prosljeđuje stanje i radnje
CityApp --> CityVM : poziva hook
CityApp --> Explorer : prosljeđuje stanje i radnje
McpView --> Explorer : prikazuje lokacije
McpView --> CommuteView : prikazuje preporuke
CommuteView --> Explorer : koristi prikaz lokacija
Explorer --> LocalVM : koristi hook za interakcije
CommuteView --> LocalVM : koristi hook za rutu
McpVM --> Decode : obrađuje rezultat
McpVM --> Bridge : koristi host vezu
CityVM --> Directory : dohvaća lokacije
Decode ..> Model : validira podatke
Directory ..> Model : vraća lokacije
@enduml
