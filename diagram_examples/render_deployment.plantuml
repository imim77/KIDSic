@startuml
title KIDSic – predloženi razmještaj na platformi Render

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #212529
}
skinparam cloud {
  BackgroundColor #F8F9FA
  BorderColor #212529
}
skinparam artifact {
  BackgroundColor #E7F1FF
  BorderColor #0D6EFD
}
skinparam database {
  BackgroundColor #FFF3CD
  BorderColor #212529
}
skinparam note {
  BackgroundColor #F8F9FA
  BorderColor #212529
}

node "Korisnički uređaj" as Device <<device>> {
  node "AI / MCP klijent" as Client <<executionEnvironment>> {
    node "MCP prikaz karte" as View <<executionEnvironment>>
  }
}

cloud "Platforma Render" as Render {
  node "Docker web-usluga" as Service <<executionEnvironment>> {
    node "Python / Uvicorn" as Python <<executionEnvironment>> {
      artifact "KIDSic MCP server" as Server <<artifact>>
      artifact "MCP HTML prikaz\nmcp.html" as HTML <<artifact>>
    }
  }
  note right of Server
    DATABASE_URL: interna veza s bazom
    Uvicorn sluša na 0.0.0.0:$PORT
  end note
  database "Render Postgres\nPostgreSQL + PostGIS + pgvector" as DB <<database>>
}

cloud "Vanjske usluge" as External {
  node "OpenStreetMap\nkartografske pločice" as Maps <<server>>
}

Client -[#blue]-> Service : <<HTTPS : 443>>\nMCP /mcp; alati i HTML resurs
View ..> Client : MCP Apps bridge\npozivi alata i rezultati
Service -[#green,bold]-> DB : <<TCP/IP : 5432>>\ninterna veza
View -[#darkorange]-> Maps : <<HTTPS : 443>>\ndohvat pločica

note bottom of DB
  Početni sadržaj: obnovljena snimka
  naše baze. Ponovni deploy ne
  prepisuje postojeće podatke.
end note
note bottom of Render
  Predložena arhitektura; još nije
  implementirana ni provjerena na Renderu.
  OTP i adresni indeksi za izračun ruta
  zahtijevaju zasebnu pripremu.
end note
@enduml
