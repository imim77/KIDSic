{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "DATABASE_URL=postgresql://kidsic:kidsic_local@localhost:55432/kidsic uv run uvicorn KIDSic.api.locations:create_app --factory --host 127.0.0.1 --port 8010"],
      "port": 8010
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "KIDSIC_API_TARGET=http://127.0.0.1:8010 npm --prefix frontend run dev -- --port 5180 --strictPort"],
      "port": 5180
    }
  ]
}
